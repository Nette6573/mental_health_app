<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Login | HopePath</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Syne:wght@600;700;800&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#2596be',
                        secondary: '#1e7fa3',
                        admin: '#0f172a',
                        adminAccent: '#2596be',
                        adminMid: '#1e293b',
                        adminBorder: '#334155',
                        neutral: '#64748b',
                        surface: '#f8fafc',
                        danger: '#ef4444',
                        gold: '#f59e0b',
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        display: ['Syne', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        :root {
            --admin-dark: #0f172a;
            --admin-mid: #1e293b;
            --admin-border: #334155;
            --admin-accent: #2596be;
        }

        body {
            background-color: var(--admin-dark);
        }

        .admin-bg {
            background:
                radial-gradient(ellipse 80% 60% at 20% 0%, rgba(37,150,190,0.12) 0%, transparent 60%),
                radial-gradient(ellipse 60% 50% at 90% 100%, rgba(30,127,163,0.10) 0%, transparent 55%),
                #0f172a;
        }

        .noise-overlay::before {
            content: '';
            position: fixed;
            inset: 0;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E");
            pointer-events: none;
            z-index: 0;
            opacity: 0.35;
        }

        .card-glass {
            background: rgba(30, 41, 59, 0.85);
            border: 1px solid rgba(51, 65, 85, 0.8);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
        }

        .input-dark {
            background: rgba(15, 23, 42, 0.6);
            border: 1px solid #334155;
            color: #e2e8f0;
            transition: all 0.2s ease;
        }
        .input-dark::placeholder { color: #475569; }
        .input-dark:focus {
            background: rgba(15, 23, 42, 0.9);
            border-color: #2596be;
            box-shadow: 0 0 0 3px rgba(37,150,190,0.15);
            outline: none;
        }
        .input-dark:hover:not(:focus) {
            border-color: #475569;
        }

        .input-group-dark:focus-within .field-label { color: #2596be; }
        .input-group-dark:focus-within .field-icon { color: #2596be; }

        .btn-admin {
            background: linear-gradient(135deg, #2596be 0%, #1e7fa3 100%);
            box-shadow: 0 4px 24px rgba(37,150,190,0.35), inset 0 1px 0 rgba(255,255,255,0.1);
            transition: all 0.2s ease;
        }
        .btn-admin:hover {
            box-shadow: 0 8px 32px rgba(37,150,190,0.5), inset 0 1px 0 rgba(255,255,255,0.15);
            transform: translateY(-1px);
        }
        .btn-admin:active { transform: translateY(0); }

        .badge-admin {
            background: linear-gradient(135deg, rgba(37,150,190,0.2), rgba(30,127,163,0.15));
            border: 1px solid rgba(37,150,190,0.3);
        }

        .glow-line {
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(37,150,190,0.5), transparent);
        }

        .security-badge {
            background: rgba(15,23,42,0.8);
            border: 1px solid rgba(37,150,190,0.25);
        }

        .pulse-dot {
            animation: pulseDot 2s infinite;
        }
        @keyframes pulseDot {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.6; transform: scale(0.85); }
        }

        .grid-bg {
            background-image:
                linear-gradient(rgba(37,150,190,0.04) 1px, transparent 1px),
                linear-gradient(90deg, rgba(37,150,190,0.04) 1px, transparent 1px);
            background-size: 40px 40px;
        }

        @keyframes slideUp {
            from { opacity: 0; transform: translateY(24px); }
            to { opacity: 1; transform: translateY(0); }
        }
        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }
        .anim-slide { animation: slideUp 0.55s cubic-bezier(0.22,1,0.36,1) both; }
        .anim-fade { animation: fadeIn 0.4s ease both; }
        .delay-1 { animation-delay: 0.1s; }
        .delay-2 { animation-delay: 0.2s; }
        .delay-3 { animation-delay: 0.3s; }
        .delay-4 { animation-delay: 0.4s; }

        .otp-input {
            background: rgba(15,23,42,0.7);
            border: 1px solid #334155;
            color: #e2e8f0;
            text-align: center;
            font-size: 1.25rem;
            font-weight: 600;
            letter-spacing: 0.05em;
            transition: all 0.2s;
        }
        .otp-input:focus {
            border-color: #2596be;
            box-shadow: 0 0 0 3px rgba(37,150,190,0.2);
            outline: none;
        }

        .modal-overlay {
            background: rgba(0,0,0,0.7);
            backdrop-filter: blur(8px);
        }

        /* Scrollbar */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: #0f172a; }
        ::-webkit-scrollbar-thumb { background: #334155; border-radius: 3px; }

        .divider-line {
            background: linear-gradient(90deg, transparent, #334155, transparent);
            height: 1px;
        }
    </style>
</head>
<body class="admin-bg noise-overlay min-h-screen flex items-center justify-center p-4 relative font-sans overflow-x-hidden">

    <!-- Grid background -->
    <div class="fixed inset-0 grid-bg opacity-100 pointer-events-none z-0"></div>

    <!-- Corner decoration top-left -->
    <div class="fixed top-0 left-0 w-64 h-64 pointer-events-none z-0">
        <svg width="256" height="256" viewBox="0 0 256 256" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M0 0 L256 0 L0 256 Z" fill="rgba(37,150,190,0.03)"/>
            <path d="M0 0 L128 0 L0 128 Z" stroke="rgba(37,150,190,0.08)" stroke-width="1" fill="none"/>
        </svg>
    </div>
    <!-- Corner decoration bottom-right -->
    <div class="fixed bottom-0 right-0 w-64 h-64 pointer-events-none z-0">
        <svg width="256" height="256" viewBox="0 0 256 256" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M256 256 L0 256 L256 0 Z" fill="rgba(37,150,190,0.03)"/>
            <path d="M256 256 L128 256 L256 128 Z" stroke="rgba(37,150,190,0.08)" stroke-width="1" fill="none"/>
        </svg>
    </div>

    <!-- Main Card -->
    <div class="w-full max-w-5xl card-glass rounded-2xl overflow-hidden flex flex-col lg:flex-row relative z-10 anim-slide">

        <!-- Left Panel - Dark branding -->
        <div class="lg:w-5/12 p-10 lg:p-12 flex flex-col justify-between relative overflow-hidden"
             style="background: linear-gradient(160deg, #1e293b 0%, #0f172a 100%); border-right: 1px solid #334155;">

            <!-- Decorative circles -->
            <div class="absolute -top-24 -right-24 w-64 h-64 rounded-full opacity-5" style="background: radial-gradient(circle, #2596be, transparent);"></div>
            <div class="absolute -bottom-16 -left-16 w-48 h-48 rounded-full opacity-5" style="background: radial-gradient(circle, #2596be, transparent);"></div>

            <!-- Top section -->
            <div class="relative z-10">
                <!-- Logo -->
                <div class="flex items-center gap-3 mb-10 anim-slide delay-1">
                    <div class="relative">
                        <img src="https://huggingface.co/spaces/brennanlondon/deepsite-project-q0z6c/resolve/main/images/hopepath.png"
                             alt="HopePath"
                             class="w-14 h-14 rounded-xl object-cover shadow-lg"
                             style="box-shadow: 0 0 0 1px rgba(37,150,190,0.3), 0 8px 24px rgba(0,0,0,0.4);">
                        <div class="absolute -bottom-1 -right-1 w-4 h-4 rounded-full bg-admin flex items-center justify-center"
                             style="border: 1px solid #2596be;">
                            <div class="w-2 h-2 rounded-full bg-adminAccent pulse-dot"></div>
                        </div>
                    </div>
                    <div>
                        <h1 class="text-2xl font-bold text-white font-display tracking-tight">HopePath</h1>
                        <div class="badge-admin rounded-full px-2 py-0.5 inline-flex items-center gap-1 mt-0.5">
                            <svg class="w-3 h-3 text-adminAccent" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                            </svg>
                            <span class="text-xs font-semibold text-adminAccent tracking-wider uppercase">Admin Portal</span>
                        </div>
                    </div>
                </div>

                <!-- Headline -->
                <div class="mb-8 anim-slide delay-2">
                    <h2 class="text-4xl font-bold text-white leading-tight mb-3 font-display">
                        Secure<br>
                        <span style="color: #2596be;">Admin</span><br>
                        Access
                    </h2>
                    <p class="text-slate-400 text-sm leading-relaxed max-w-xs">
                        Restricted to authorized HopePath administrators only. All sessions are monitored and logged.
                    </p>
                </div>

                <!-- Glow line -->
                <div class="glow-line mb-8 anim-fade delay-3"></div>

                <!-- Feature list -->
                <div class="space-y-3 anim-slide delay-3">
                    <div class="flex items-center gap-3 group">
                        <div class="w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0"
                             style="background: rgba(37,150,190,0.12); border: 1px solid rgba(37,150,190,0.2);">
                            <svg class="w-4 h-4 text-adminAccent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                            </svg>
                        </div>
                        <span class="text-sm text-slate-300">Manage providers and users</span>
                    </div>
                    <div class="flex items-center gap-3 group">
                        <div class="w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0"
                             style="background: rgba(37,150,190,0.12); border: 1px solid rgba(37,150,190,0.2);">
                            <svg class="w-4 h-4 text-adminAccent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                            </svg>
                        </div>
                        <span class="text-sm text-slate-300">Platform analytics and reporting</span>
                    </div>
                    <div class="flex items-center gap-3 group">
                        <div class="w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0"
                             style="background: rgba(37,150,190,0.12); border: 1px solid rgba(37,150,190,0.2);">
                            <svg class="w-4 h-4 text-adminAccent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                            </svg>
                        </div>
                        <span class="text-sm text-slate-300">System configuration and settings</span>
                    </div>
                    <div class="flex items-center gap-3 group">
                        <div class="w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0"
                             style="background: rgba(37,150,190,0.12); border: 1px solid rgba(37,150,190,0.2);">
                            <svg class="w-4 h-4 text-adminAccent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                            </svg>
                        </div>
                        <span class="text-sm text-slate-300">Provider application reviews</span>
                    </div>
                </div>
            </div>

            <!-- Bottom security note -->
            <div class="relative z-10 mt-8 security-badge rounded-xl p-3 flex items-start gap-3 anim-fade delay-4">
                <svg class="w-4 h-4 text-gold mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                </svg>
                <p class="text-xs text-slate-400 leading-relaxed">
                    <span class="text-gold font-semibold">Restricted access.</span> Unauthorized login attempts are logged and may result in account suspension.
                </p>
            </div>
        </div>

        <!-- Right Panel - Login Form -->
        <div class="lg:w-7/12 p-8 lg:p-12 flex flex-col justify-center"
             style="background: rgba(15,23,42,0.5);">

            <div class="max-w-md w-full mx-auto">

                <!-- Header -->
                <div class="mb-8 anim-slide delay-1">
                    <div class="flex items-center gap-2 mb-4">
                        <div class="flex gap-1 items-center">
                            <div class="w-1.5 h-1.5 rounded-full bg-adminAccent pulse-dot"></div>
                            <span class="text-xs font-semibold text-adminAccent tracking-widest uppercase">Secure Session</span>
                        </div>
                    </div>
                    <h2 class="text-2xl font-bold text-white mb-1.5 font-display">Administrator Sign In</h2>
                    <p class="text-slate-400 text-sm">Enter your admin credentials to access the control panel</p>
                </div>

                <!-- Login Form -->
                <form id="adminLoginForm" class="space-y-4">

                    <!-- Admin ID -->
                    <div class="input-group-dark anim-slide delay-2">
                        <label class="field-label block text-xs font-semibold text-slate-400 mb-1.5 tracking-wider uppercase transition-colors">Admin ID</label>
                        <div class="relative">
                            <svg class="field-icon w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-500 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V8a2 2 0 00-2-2h-5m-4 0V5a2 2 0 114 0v1m-4 0a2 2 0 104 0m-5 8a2 2 0 100-4 2 2 0 000 4zm0 0c1.306 0 2.417.835 2.83 2M9 14a3.001 3.001 0 00-2.83 2"/>
                            </svg>
                            <input type="text" id="adminId" required
                                class="input-dark w-full pl-10 pr-4 py-3 rounded-xl text-sm font-mono"
                                placeholder="ADMIN-XXXXX">
                        </div>
                    </div>

                    <!-- Email -->
                    <div class="input-group-dark anim-slide delay-2">
                        <label class="field-label block text-xs font-semibold text-slate-400 mb-1.5 tracking-wider uppercase transition-colors">Email Address</label>
                        <div class="relative">
                            <svg class="field-icon w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-500 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                            </svg>
                            <input type="email" id="adminEmail" required
                                class="input-dark w-full pl-10 pr-4 py-3 rounded-xl text-sm"
                                placeholder="admin@hopepath.jm">
                        </div>
                    </div>

                    <!-- Password -->
                    <div class="input-group-dark anim-slide delay-3">
                        <label class="field-label block text-xs font-semibold text-slate-400 mb-1.5 tracking-wider uppercase transition-colors">Password</label>
                        <div class="relative">
                            <svg class="field-icon w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-500 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                            </svg>
                            <input type="password" id="adminPassword" required
                                class="input-dark w-full pl-10 pr-12 py-3 rounded-xl text-sm"
                                placeholder="••••••••••••">
                            <button type="button" onclick="toggleAdminPassword()"
                                class="absolute right-3 top-1/2 -translate-y-1/2 p-1.5 rounded-lg text-slate-500 hover:text-slate-300 transition-colors hover:bg-white/5">
                                <svg id="eyeIconAdmin" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                </svg>
                            </button>
                        </div>
                    </div>

                    <!-- Divider -->
                    <div class="divider-line my-5 anim-fade delay-3"></div>

                    <!-- 2FA Section -->
                    <div class="anim-slide delay-3">
                        <div class="flex items-center justify-between mb-2">
                            <label class="text-xs font-semibold text-slate-400 tracking-wider uppercase">2FA Verification Code</label>
                            <span class="text-xs text-adminAccent cursor-pointer hover:text-primary transition-colors" onclick="toggle2FA()">
                                <span id="twofa-toggle-label">I have a code</span>
                            </span>
                        </div>

                        <div id="twofaSection" class="hidden">
                            <div class="flex gap-2 justify-between">
                                <input class="otp-input w-full h-12 rounded-xl text-white" maxlength="1" type="text" inputmode="numeric" pattern="[0-9]*">
                                <input class="otp-input w-full h-12 rounded-xl text-white" maxlength="1" type="text" inputmode="numeric" pattern="[0-9]*">
                                <input class="otp-input w-full h-12 rounded-xl text-white" maxlength="1" type="text" inputmode="numeric" pattern="[0-9]*">
                                <span class="flex items-center text-slate-600 font-bold">-</span>
                                <input class="otp-input w-full h-12 rounded-xl text-white" maxlength="1" type="text" inputmode="numeric" pattern="[0-9]*">
                                <input class="otp-input w-full h-12 rounded-xl text-white" maxlength="1" type="text" inputmode="numeric" pattern="[0-9]*">
                                <input class="otp-input w-full h-12 rounded-xl text-white" maxlength="1" type="text" inputmode="numeric" pattern="[0-9]*">
                            </div>
                            <p class="text-xs text-slate-500 mt-2">Enter the 6-digit code from your authenticator app</p>
                        </div>

                        <div id="twofaPlaceholder" class="rounded-xl p-3 flex items-center gap-3"
                             style="background: rgba(37,150,190,0.06); border: 1px dashed rgba(37,150,190,0.2);">
                            <svg class="w-4 h-4 text-adminAccent flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2v-1a7 7 0 00-7-7 7 7 0 00-7 7v1a2 2 0 002 2zm8-13.5A4 4 0 118 7.5a4 4 0 018 0z"/>
                            </svg>
                            <p class="text-xs text-slate-500">Two-factor authentication adds an extra layer of security</p>
                        </div>
                    </div>

                    <!-- Remember & Forgot -->
                    <div class="flex items-center justify-between anim-slide delay-4">
                        <label class="flex items-center gap-2 cursor-pointer group">
                            <input type="checkbox" id="adminRememberMe"
                                class="w-4 h-4 rounded border-slate-600 bg-slate-800 text-adminAccent focus:ring-adminAccent focus:ring-offset-admin cursor-pointer">
                            <span class="text-sm text-slate-500 group-hover:text-slate-300 transition-colors">Keep me signed in</span>
                        </label>
                        <button type="button" onclick="showForgotModal()"
                            class="text-sm text-adminAccent hover:text-primary font-medium transition-colors">
                            Forgot password?
                        </button>
                    </div>

                    <!-- Submit -->
                    <button type="submit" id="adminLoginBtn"
                        class="btn-admin w-full py-3.5 text-white rounded-xl font-semibold text-sm tracking-wide flex items-center justify-center gap-2 anim-slide delay-4">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"/>
                        </svg>
                        <span>Access Admin Panel</span>
                    </button>
                </form>

                <!-- Error Message -->
                <div id="errorMsg" class="hidden mt-4 p-3 rounded-xl flex items-center gap-3 text-sm"
                     style="background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.25);">
                    <svg class="w-4 h-4 text-danger flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                    </svg>
                    <span id="errorText" class="text-red-400"></span>
                </div>

                <!-- Footer links -->
                <div class="mt-8 pt-6 anim-fade delay-4" style="border-top: 1px solid #1e293b;">
                    <div class="flex items-center justify-center gap-6">
                        <a href="login.html" class="text-xs text-slate-500 hover:text-slate-300 transition-colors flex items-center gap-1.5">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                            </svg>
                            Provider Login
                        </a>
                        <span class="text-slate-700 text-xs">|</span>
                        <a href="#" class="text-xs text-slate-500 hover:text-slate-300 transition-colors flex items-center gap-1.5">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                            Support
                        </a>
                        <span class="text-slate-700 text-xs">|</span>
                        <a href="#" class="text-xs text-slate-500 hover:text-slate-300 transition-colors flex items-center gap-1.5">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                            </svg>
                            Privacy Policy
                        </a>
                    </div>
                    <p class="text-center text-xs text-slate-600 mt-4">
                        HopePath Admin v2.4.1 &bull; &copy; 2026 HopePath. All rights reserved.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Forgot Password Modal -->
    <div id="forgotModal" class="fixed inset-0 modal-overlay z-50 hidden items-center justify-center p-4">
        <div class="card-glass rounded-2xl max-w-md w-full p-6 shadow-2xl transform transition-all scale-95 opacity-0" id="forgotModalContent"
             style="border: 1px solid #334155;">
            <div class="text-center mb-6">
                <div class="w-14 h-14 rounded-2xl flex items-center justify-center mx-auto mb-4"
                     style="background: rgba(37,150,190,0.12); border: 1px solid rgba(37,150,190,0.25);">
                    <svg class="w-7 h-7 text-adminAccent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
                    </svg>
                </div>
                <h3 class="text-xl font-bold text-white mb-1 font-display">Reset Admin Password</h3>
                <p class="text-sm text-slate-400">Enter your admin email and we'll send a secure reset link</p>
            </div>
            <form id="forgotForm" class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-400 mb-1.5 tracking-wider uppercase">Admin Email Address</label>
                    <input type="email" required
                        class="input-dark w-full px-4 py-3 rounded-xl text-sm"
                        placeholder="admin@hopepath.jm">
                </div>
                <div class="flex gap-3 pt-2">
                    <button type="button" onclick="closeForgotModal()"
                        class="flex-1 px-4 py-3 rounded-xl text-sm font-medium text-slate-400 hover:text-slate-200 transition-colors"
                        style="border: 1px solid #334155; background: rgba(15,23,42,0.5);">
                        Cancel
                    </button>
                    <button type="submit"
                        class="btn-admin flex-1 px-4 py-3 rounded-xl text-sm font-semibold text-white">
                        Send Reset Link
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
        // OTP input auto-tab
        document.querySelectorAll('.otp-input').forEach((input, index, inputs) => {
            input.addEventListener('input', function () {
                const val = this.value.replace(/[^0-9]/g, '');
                this.value = val;
                if (val && index < inputs.length - 1) {
                    inputs[index + 1].focus();
                }
            });
            input.addEventListener('keydown', function (e) {
                if (e.key === 'Backspace' && !this.value && index > 0) {
                    inputs[index - 1].focus();
                }
            });
        });

        // Toggle 2FA section
        let twoFAVisible = false;
        function toggle2FA() {
            twoFAVisible = !twoFAVisible;
            const section = document.getElementById('twofaSection');
            const placeholder = document.getElementById('twofaPlaceholder');
            const label = document.getElementById('twofa-toggle-label');
            if (twoFAVisible) {
                section.classList.remove('hidden');
                placeholder.classList.add('hidden');
                label.textContent = 'Hide';
            } else {
                section.classList.add('hidden');
                placeholder.classList.remove('hidden');
                label.textContent = 'I have a code';
            }
        }

        // Password toggle
        let pwVisible = false;
        function toggleAdminPassword() {
            pwVisible = !pwVisible;
            const input = document.getElementById('adminPassword');
            const icon = document.getElementById('eyeIconAdmin');
            input.type = pwVisible ? 'text' : 'password';
            icon.innerHTML = pwVisible
                ? '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"/>'
                : '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>';
        }

        // Form submit
        document.getElementById('adminLoginForm').addEventListener('submit', function (e) {
            e.preventDefault();
            const btn = document.getElementById('adminLoginBtn');
            const errorMsg = document.getElementById('errorMsg');
            const errorText = document.getElementById('errorText');

            errorMsg.classList.add('hidden');

            const adminId = document.getElementById('adminId').value.trim();
            if (!adminId.startsWith('ADMIN-') && adminId !== '') {
                errorMsg.classList.remove('hidden');
                errorText.textContent = 'Admin ID format must be ADMIN-XXXXX';
                return;
            }

            btn.disabled = true;
            btn.innerHTML = `
                <svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                <span>Authenticating...</span>
            `;

            const rememberMe = document.getElementById('adminRememberMe').checked;
            if (rememberMe) {
                localStorage.setItem('hopepath_admin_email', document.getElementById('adminEmail').value);
            } else {
                localStorage.removeItem('hopepath_admin_email');
            }

            setTimeout(() => {
                window.location.href = 'admin-dashboard.html';
            }, 1800);
        });

        // Forgot modal
        function showForgotModal() {
            const modal = document.getElementById('forgotModal');
            const content = document.getElementById('forgotModalContent');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            setTimeout(() => {
                content.classList.remove('scale-95', 'opacity-0');
                content.classList.add('scale-100', 'opacity-100');
            }, 10);
        }

        function closeForgotModal() {
            const modal = document.getElementById('forgotModal');
            const content = document.getElementById('forgotModalContent');
            content.classList.remove('scale-100', 'opacity-100');
            content.classList.add('scale-95', 'opacity-0');
            setTimeout(() => {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
            }, 200);
        }

        document.getElementById('forgotModal').addEventListener('click', function (e) {
            if (e.target === this) closeForgotModal();
        });

        document.getElementById('forgotForm').addEventListener('submit', function (e) {
            e.preventDefault();
            alert('Admin password reset link sent to your email.');
            closeForgotModal();
        });

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') closeForgotModal();
        });

        // Restore remembered email
        window.addEventListener('load', function () {
            const saved = localStorage.getItem('hopepath_admin_email');
            if (saved) {
                document.getElementById('adminEmail').value = saved;
                document.getElementById('adminRememberMe').checked = true;
            }
        });
    </script>
</body>
</html>
